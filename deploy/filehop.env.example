# /etc/filehop/filehop.env (mode 0640, root:filehop). Example values only.

FILEHOP_ADDR=127.0.0.1:8095
FILEHOP_DB=/var/lib/filehop/filehop.db
FILEHOP_BASE_URL=https://file.hel.ink
# Secure cookies: on by default when FILEHOP_BASE_URL is https.
# FILEHOP_SECURE_COOKIES=true

# Sign-in with HOP ID. Leave FILEHOP_SSO_URL empty to run without accounts
# (the converter works fully for guests; /hop/* then answers 404 not_configured).
# The browser goes to <FILEHOP_SSO_URL>/sso/<FILEHOP_SSO_CLIENT> and comes back to
# <FILEHOP_BASE_URL>/auth/sso/callback. The secret (32+ characters) is the same
# value the hub has as HOP_SSO_SECRET_FILEHOP; generate it once with
#   openssl rand -hex 32
FILEHOP_SSO_URL=https://hub.hel.ink
FILEHOP_SSO_SECRET=
FILEHOP_SSO_CLIENT=filehop

# Apps that may call the signed /hop/* API with FILEHOP_SSO_SECRET:
# imperium (health, stats, users) and helink (the hub's account events).
FILEHOP_HOP_CLIENTS=imperium,helink

# Save to PixelHop (off unless the secret is set): a signed-in person can send one finished image or PDF
# through this server to their PixelHop library, after confirming it. The secret is FileHop's OWN secret for
# PixelHop's store (32+ characters, `openssl rand -hex 32`), the same value PixelHop has as
# HOP_STORE_SECRET_FILEHOP with PIXELHOP_STORE_CLIENTS=filehop there. Never the SSO secret (refused at start).
# FILEHOP_PIXELHOP_URL defaults to pixel.<the hub's host without its first label, hub.hel.ink → hel.ink>; FILEHOP_PIXELHOP_MAX_MB must not exceed
# PixelHop's PIXELHOP_MAX_UPLOAD_MB (default 20).
# PixelHop answers with addresses on its link host (its PIXELHOP_LINK_URL, p.hel.ink), which FileHop
# passes on when that host is on that same family domain. Set FILEHOP_PIXELHOP_LINK_URL (one https base
# address, lower case, no port) only when PixelHop's link host is on another domain; without it such a
# save still succeeds but the "Open" link goes to PixelHop's front page. Plain http is accepted only
# when FILEHOP_PIXELHOP_URL is plain http too (a local copy).
FILEHOP_PIXELHOP_SECRET=
# FILEHOP_PIXELHOP_URL=https://pixel.hel.ink
# FILEHOP_PIXELHOP_LINK_URL=https://p.hel.ink
# FILEHOP_PIXELHOP_MAX_MB=20

# /send (a file straight from one device to another). Behind nginx set TRUST_PROXY=1 so the
# per-visitor rate limits use the address nginx passes in X-Forwarded-For ($remote_addr); without
# it every visitor looks like 127.0.0.1 and shares one limit. STUN_URLS is a comma-separated list
# of STUN servers the browsers use to find a route between two networks; leave it empty and /send
# only works between devices on the same network. No TURN: a pair that cannot connect is told so.
# STUN servers see each device's public IP address (so does the other device).
# Prerequisite: nginx must pass the real visitor address in $remote_addr (behind Cloudflare:
# set_real_ip_from + real_ip_header CF-Connecting-IP, usually in a global conf.d file); otherwise
# all visitors share one address and one limit.
FILEHOP_TRUST_PROXY=1
FILEHOP_STUN_URLS=stun:stun.cloudflare.com:3478
