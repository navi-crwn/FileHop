{
  "name": "filehop-root",
  "private": true,
  "type": "module",
  "description": "FileHop: the Go server at the root, the browser app in web/.",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "check": "npm run check -w web",
    "test": "node tools/unit.test.mjs && node tools/send.test.mjs && node tools/pixelhop.test.mjs",
    "lint:i18n": "node tools/check-i18n.mjs",
    "fixtures": "node tools/make-fixtures.mjs && node tools/make-hostile.mjs",
    "fixtures:dist": "node tools/copy-fixtures.mjs",
    "start": "node tools/serve.mjs",
    "matrix": "node tools/browser-matrix.mjs",
    "local": "node tools/run-local.mjs"
  }
}
